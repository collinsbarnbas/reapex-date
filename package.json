{
  "name": "reapex-date",
  "version": "0.1.0",
  "description": "Headless, accessible, fully customizable React Date & Time Picker with i18n, range selection, and data-attribute styling",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs",
      "types": "./dist/engine/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs",
      "types": "./dist/hooks/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs",
      "types": "./dist/components/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.9",
    "dayjs": "^1.11.21"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "datepicker",
    "date-picker",
    "calendar",
    "headless",
    "accessible",
    "aria",
    "typescript",
    "date-range",
    "range-picker",
    "timepicker",
    "datetime",
    "i18n",
    "rtl",
    "locale",
    "customizable",
    "unstyled"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reapex/reapex-date"
  }
}
